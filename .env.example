# --- OpenRouter (Threshold AI Assistant) ---
# Get a free key at https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# --- OpenWeather (Dashboard widget) ---
# Get a free key at https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=

# --- EmailJS (Contact form) ---
# Create a service at https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# --- Plausible analytics (optional) ---
# Self-host or use plausible.io. Leave blank to disable analytics entirely.
# Example for plausible.io: "portfolio.example.com"
VITE_ANALYTICS_DOMAIN=

# --- Cascade audit (NOT a VITE_ var; used only by scripts/verify-cascade.mjs) ---
# Same OpenRouter key, but read by the Node audit script via `process.env`.
# Set it in your shell before running `npm run audit:cascade`.
# OPENROUTER_API_KEY=sk-or-v1-...

# --- GitHub live contributions (optional) ---
# Uncomment to fetch the real GitHub contribution grid from
# https://github.com/users/bikash-20.contributions (public endpoint, no auth).
# Leave commented out (default) to keep the synthetic demo grid.
# VITE_GITHUB_CONTRIBUTIONS=live
